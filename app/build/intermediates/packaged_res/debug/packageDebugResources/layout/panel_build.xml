<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/panel_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/buildStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="Idle"
            android:textColor="@color/text_dim"
            android:textSize="@dimen/text_sm" />

        <TextView
            android:id="@+id/btnBuildCopy"
            style="@style/ToolbarButtonSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⧉" />

        <TextView
            android:id="@+id/btnBuildSave"
            style="@style/ToolbarButtonSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💾" />

        <TextView
            android:id="@+id/btnBuildClear"
            style="@style/ToolbarButtonSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🗑" />

        <TextView
            android:id="@+id/btnBuildCancel"
            style="@style/ToolbarButtonSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <ScrollView
        android:id="@+id/buildScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/panel_bg"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/buildOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text=""
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textIsSelectable="true"
            android:typeface="monospace" />
    </ScrollView>

    <ProgressBar
        android:id="@+id/buildProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:visibility="gone" />

</LinearLayout>
